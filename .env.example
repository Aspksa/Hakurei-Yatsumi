# Обязательно: длинный случайный секрет для связи Node-шлюза с Python-backend.
YATSUMI_API_KEY=replace-with-a-long-random-secret

# Путь к базе SQLite.
YATSUMI_DB_PATH=backend/data/yatsumi.db

# Адрес Python-backend (только локальный http).
PYTHON_API_URL=http://127.0.0.1:8000

# Порт сайта (Node-шлюз).
YATSUMI_NODE_PORT=3000

# Таймаут запроса шлюза к backend, мс (100–120000).
YATSUMI_PROXY_TIMEOUT_MS=10000

# Очередь запросов шлюза: длина и число параллельных.
YATSUMI_QUEUE_LIMIT=32
YATSUMI_QUEUE_CONCURRENCY=2

# Файл логов шлюза (пусто — только консоль).
YATSUMI_NODE_LOG=
